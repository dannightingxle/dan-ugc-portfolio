{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/hub/cron/weekly?step=stats",
      "schedule": "0 5 * * 1,4"
    },
    {
      "path": "/api/hub/cron/weekly?step=ideas",
      "schedule": "15 5 * * 1,4"
    },
    {
      "path": "/api/hub/cron/weekly?step=plan",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/hub/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
